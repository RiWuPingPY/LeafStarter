{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leafstarter-site",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-20",
  "routes": [{ "pattern": "leafstarter.pingyi.me", "custom_domain": true }],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/download/*", "/update/*", "/cf/*"]
  },
  // 下载开不开：公测时改成 "true" 再部署
  "vars": { "DOWNLOADS_OPEN": "false" },
  // CurseForge 代理：每个 IP 每分钟 120 次。Key 用 npx wrangler secret put CF_API_KEY 放进来
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // R2（11-28 建好）：
  //   安装包和版本信息：releases/latest.json、releases/<版本>/<文件>；自动更新信息：update/<频道>.json；下载次数：stats/downloads.json
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "leafstarter-releases" }],
  "observability": { "enabled": true }
}
