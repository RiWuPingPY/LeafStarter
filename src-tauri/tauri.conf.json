{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeafStarter",
  "mainBinaryName": "leafstarter",
  "version": "0.1.0",
  "identifier": "com.leafhub.leafstarter",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run serve"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LeafStarter",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
